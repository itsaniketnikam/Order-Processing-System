NODE_ENV=development
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=ordermanagement

JWT_SECRET=replace-me-with-a-strong-secret
JWT_EXPIRES_IN=3600s

SWAGGER_ENABLED=true

# Cron expression for the background job that promotes PENDING orders to PROCESSING.
# Default: every 5 minutes.
ORDERS_PROCESS_PENDING_CRON=*/5 * * * *

# Shared secret for fulfillment PATCH /orders/:id/status (X-Admin-Key header)
ADMIN_API_KEY=change-me-fulfillment-key
